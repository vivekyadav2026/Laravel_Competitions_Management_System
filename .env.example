APP_NAME="Fsaludoclub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Connection (MySQL 8.0+ / MariaDB 10.4+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=royalludo_production
DB_USERNAME=royalludo_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# Drivers
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Mailer Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fsaludoclub Platform Specific Switches
LUDO_BRAND_NAME="Fsaludoclub"
LUDO_BRAND_DISPLAY="FSALUDOCLUB"
UPI_DEPOSITS_ENABLED=false
LUDO_VIRTUAL_POINTS_ONLY=true
LUDO_ALLOW_CASH_GATEWAY=false
LUDO_MIN_BATTLE_POINTS=50
LUDO_MAX_BATTLE_POINTS=50000

# HSP SMS Gateway Credentials & Configuration
HSPSMS_API_URL=http://sms.hspsms.com/sendSMS
HSPSMS_USERNAME=fsclub
HSPSMS_API_KEY=f85eb1ba-485e-44c6-9002-8f7948abb803
HSPSMS_SENDER_NAME=DPCORN
HSPSMS_SMS_TYPE=TRANS
HSPSMS_MESSAGE_TEMPLATE="{otp} is Your One Time Password(OTP) for DEEP CORNER."
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN=60

